{
  "name": "ybiq",
  "version": "21.0.3",
  "description": "Useful command-line tools for Node.js project",
  "author": "Masafumi Koba",
  "license": "MIT",
  "repository": "ybiquitous/ybiq",
  "keywords": [
    "cli",
    "command-line",
    "utility",
    "tool"
  ],
  "type": "module",
  "exports": "./lib/index.js",
  "bin": "./lib/cli.js",
  "types": "./types/ybiq.d.ts",
  "files": [
    "lib",
    "types/ybiq.d.ts",
    ".editorconfig",
    ".githooks/commit-msg",
    ".githooks/pre-commit",
    ".github/workflows/dependabot-auto-merge.yml",
    ".github/workflows/npm-audit-fix.yml",
    ".github/workflows/npm-diff.yml",
    ".github/workflows/release-pr.yml",
    ".github/workflows/release.yml",
    ".github/workflows/test.yml"
  ],
  "engines": {
    "node": ">=22.17.0"
  },
  "publishConfig": {
    "provenance": true
  },
  "dependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.1.0",
    "@eslint/js": "^10.0.1",
    "conventional-changelog": "^8.1.0",
    "conventional-changelog-conventionalcommits": "^10.2.1",
    "conventional-commits-filter": "^6.0.1",
    "eslint": "^10.8.0",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "remark-cli": "^12.0.1",
    "yargs": "^18.0.0"
  },
  "devDependencies": {
    "@tsconfig/strictest": "^2.0.8",
    "@types/node": "^26.1.0",
    "@types/yargs": "^17.0.35",
    "eslint-plugin-n": "^18.2.1",
    "remark-preset-ybiquitous": "^0.5.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.1"
  },
  "scripts": {
    "pretest": "npm run lint",
    "test": "npm run test:types && node --test",
    "test:watch": "node --test --watch",
    "test:coverage": "node --test --experimental-test-coverage",
    "test:snapshot": "node --test --test-update-snapshots",
    "test:types": "tsc --project types/tsconfig.test.json",
    "lint:js": "eslint --cache",
    "lint:js:fix": "npm run lint:js -- --fix",
    "lint:md": "remark . --frail",
    "lint:md:fix": "remark . --output",
    "lint:types": "tsc --noEmit",
    "lint:types:watch": "npm run lint:types -- --watch",
    "lint:commit": "commitlint --from HEAD~10",
    "lint": "ybiq run --npm lint:js lint:md lint:types lint:commit lint:styles",
    "prettier": "prettier --cache .",
    "lint:styles": "npm run prettier -- --check",
    "lint:styles:fix": "npm run prettier -- --write",
    "format": "ybiq run --npm lint:js:fix lint:md:fix lint:styles:fix",
    "clean": "git clean -dx --force --exclude=node_modules",
    "changelog": "ybiq changelog",
    "changelog:dryrun": "ybiq changelog --dry-run",
    "postversion": "npm run changelog",
    "prepare": "git config set --local core.hooksPath .githooks || true",
    "postprepare": "ln -sf \"${PWD}/lib/cli.js\" node_modules/.bin/ybiq"
  },
  "lint-staged": {
    "*.{js,jsx,cjs,mjs,ts,tsx}": "eslint --cache --fix",
    "!(**/*.snapshot|.githooks/**)": "prettier --cache --write",
    "!(CHANGELOG).md": "remark --frail"
  },
  "remarkConfig": {
    "plugins": [
      "remark-preset-ybiquitous"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ],
    "rules": {
      "body-max-line-length": [
        2,
        "always",
        400
      ],
      "footer-max-line-length": [
        2,
        "always",
        200
      ],
      "header-max-length": [
        2,
        "always",
        200
      ],
      "scope-enum": [
        2,
        "always",
        [
          "",
          "actions",
          "api",
          "changelog",
          "commitlint",
          "coverage",
          "deps",
          "deps-dev",
          "editorconfig",
          "eslint",
          "husky",
          "init",
          "lint-staged",
          "package",
          "prettier",
          "readme",
          "release",
          "remark",
          "run",
          "types"
        ]
      ]
    }
  },
  "browserslist": [
    "> 1%",
    "not ie 11",
    "not op_mini all"
  ]
}
